{
  "manifest_version": 3,
  "name": "AI Web-Auto",
  "version": "1.0.0",
  "description": "CDP-first browser automation engine for AI-driven web interaction",
  "permissions": [
    "activeTab",
    "tabs",
    "cookies",
    "storage",
    "scripting",
    "webRequest",
    "downloads",
    "offscreen",
    "alarms",
    "debugger"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "js/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/content/content-main.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "html/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
