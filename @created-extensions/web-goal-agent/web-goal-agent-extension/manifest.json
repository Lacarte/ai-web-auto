{
  "manifest_version": 3,
  "name": "Web Goal Agent",
  "version": "0.1.0",
  "description": "Goal-driven browser automation on ai-web-auto: observe, plan, act, verify, recover — with visible, verified steps.",
  "key": "",
  "minimum_chrome_version": "121",
  "permissions": ["activeTab", "alarms", "debugger", "nativeMessaging", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "js/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "html/popup.html",
    "default_title": "Web Goal Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
